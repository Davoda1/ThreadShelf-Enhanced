HOST=127.0.0.1
PORT=3000
# Comma-separated host names/IP addresses permitted to access the server.
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser requests normally require the exact server origin, including scheme
# and port. Optional comma-separated full origins for a deliberate reverse-proxy
# or separate browser frontend. Native Reader/Alternative clients need no entry.
ALLOWED_ORIGINS=

# Headless trusted-LAN web access (independent; only 1 enables; restart required).
# 0/unset keeps management localhost-only. Existing keyed API access is unchanged.
# 1 grants full feature controls to clients allowed by HOST/ALLOWED_HOSTS and
# browser Origin policy, without an API key. These are not subnet filters or
# authentication; keep this server on a trusted network.
ALLOW_LAN_AI=0
ALLOW_LAN_TTS=0
# AI includes chat, model setup, folder browsing and connected Markdown vaults.
# TTS includes setup, providers, credentials, saved audio and playback. You still
# enable speech and explicitly download voices in Settings → Text-to-Speech.

# Optional external OpenRouter conversation generation.
# Copy this file to .env, paste your key, and restart ThreadShelf.
# Never commit the populated .env file.
OPENROUTER_API_KEY=

# Hugging Face token. The model catalog and normal GGUF downloads work without
# it; it is only required for gated repositories, whose licence you must accept
# on huggingface.co first. HUGGING_FACE_HUB_TOKEN is accepted as an alias.
HF_TOKEN=

# GitHub token. Optional: raises the anonymous API rate limit when ThreadShelf
# resolves the official ggml-org/llama.cpp release. GH_TOKEN is an alias.
GITHUB_TOKEN=
