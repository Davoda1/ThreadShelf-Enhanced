{
  "name": "threadshelf-enhanced",
  "version": "1.3.0",
  "description": "ThreadShelf Enhanced — local AI conversation archive, rich reader and compatible search server",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "semantic-search",
    "rag",
    "local-first",
    "chatgpt",
    "claude",
    "openrouter",
    "lm-studio",
    "grok",
    "lancedb",
    "mcp"
  ],
  "bin": {
    "threadshelf": "./bin/threadshelf.js",
    "threadshelf-mcp": "./bin/threadshelf-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "public/",
    "scripts/openrouter-export-all.js",
    "scripts/openrouter-export-browser.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "workspaces": [
    "client"
  ],
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.5": true
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    },
    "onnxruntime-node": {
      "adm-zip": "0.6.1",
      "global-agent": "4.1.3"
    },
    "seroval": "1.6.3"
  },
  "scripts": {
    "test": "node scripts/run-node-tests.js test",
    "test:e2e": "node scripts/run-node-tests.js test/e2e",
    "test:playwright": "playwright test",
    "check:repo": "node --import tsx scripts/check-repo-hygiene.ts",
    "check": "npm run check:repo && npm run check:security && npm run lint && npx tsc --noEmit && npm test && npm run test:e2e && npm run build:client && npm run test:playwright",
    "parse": "node --import tsx src/cli.ts",
    "ingest": "node --import tsx src/ingest-cli.ts",
    "search": "node --import tsx src/search-cli.ts",
    "setup:llama": "node --import tsx scripts/setup-llama-cpp.ts",
    "start": "node --import tsx src/server.ts",
    "dev": "node --watch --import tsx src/server.ts",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build --workspace client",
    "mcp": "node --import tsx mcp/server.ts",
    "lint": "eslint src/ mcp/ client/src/",
    "format": "prettier --write \"src/**/*.ts\" \"client/src/**/*.{ts,tsx}\"",
    "build:server": "tsc -p tsconfig.build.json",
    "build:package": "npm run clean:dist && npm run build:client && npm run build:server",
    "clean:dist": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build:package",
    "pack:verify": "node scripts/verify-package.js",
    "check:security": "node scripts/check-security.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.29.0",
    "@zip.js/zip.js": "2.24.0",
    "express": "^5.2.1",
    "multer": "^2.5.0",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "8.2.4"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davoda1/ThreadShelf-Enhanced.git"
  },
  "bugs": {
    "url": "https://github.com/Davoda1/ThreadShelf-Enhanced/issues"
  },
  "homepage": "https://github.com/Davoda1/ThreadShelf-Enhanced#readme"
}
