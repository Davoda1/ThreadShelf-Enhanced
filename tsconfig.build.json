{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": false,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "mcp/**/*.ts",
    "src/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "client",
    "dist",
    "test",
    "public",
    "scripts"
  ]
}
